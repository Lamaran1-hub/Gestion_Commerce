# EN LIGNE (production) — à vérifier avec « php artisan securite:verifier » :
#   APP_ENV=production   APP_DEBUG=false   APP_URL=https://votre-domaine
#   LOG_LEVEL=warning    SESSION_SECURE_COOKIE=true (par défaut en production)
#   Ce fichier .env ne doit JAMAIS être dans public_html ni envoyé à quelqu'un : il contient les mots de passe et clés API.
APP_NAME="Gestion commerciale"
APP_TIMEZONE=Africa/Conakry
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_commerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inscription libre des boutiques depuis la page d'accueil (essai gratuit)
GESTION_INSCRIPTION_OUVERTE=true
GESTION_JOURS_ESSAI=14
# Compte super-administrateur de la plateforme (créé par le seeder) — supprimez SUPER_ADMIN_PASSWORD une fois le compte créé
SUPER_ADMIN_EMAIL=proprietaire@exemple.com
SUPER_ADMIN_PASSWORD=ChangezMoi2026!

GESTION_INACTIVITE_MINUTES=30

# Paiement des licences en ligne (Djomy) — identifiants dans votre espace développeur Djomy
# DJOMY_MODE=sandbox (test, aucun argent réel) puis production une fois tout vérifié
# L'URL est choisie selon le mode ; DJOMY_BASE_URL ne sert qu'à la forcer si Djomy en donne une autre
DJOMY_ACTIF=false
DJOMY_MODE=sandbox
DJOMY_BASE_URL=
DJOMY_NUMERO_MARCHAND=224627406834
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
DJOMY_PAYS=GN
DJOMY_MOYENS=OM,MOMO,CARD,PAYCARD,KULU,SOUTRA_MONEY
